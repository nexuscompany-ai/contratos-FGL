# Produção: DATABASE_URL e BLOB_READ_WRITE_TOKEN são criadas automaticamente
# ao conectar Postgres e Blob ao projeto na Vercel (Storage → Create Database).
# Em desenvolvimento local sem Postgres, deixe DATABASE_URL ausente: o app usa
# um SQLite local (./dev.db) só para rodar localmente — isso não afeta produção.
# DATABASE_URL="postgresql://user:password@host:5432/dbname"
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

SESSION_SECRET="troque-este-segredo-em-producao"
BASE_URL="http://localhost:3000"
PORT=3000
# ADMIN_NAME="Administrador FGL"
# ADMIN_EMAIL="admin@fgl.com.br"
# ADMIN_PASSWORD="troque-esta-senha"
# FELIPE_EMAIL="felipe@fgl.com.br"
# GABRIEL_EMAIL="gabriel@fgl.com.br"

# E-mails automáticos (aprovação/boas-vindas + lembretes de vencimento).
# Conta Gmail dedicada + senha de app (Conta Google → Segurança → Senhas de
# app, com verificação em duas etapas ativada). Sem essas duas variáveis, o
# envio é pulado silenciosamente (só loga no console).
# GMAIL_USER="conta@gmail.com"
# GMAIL_APP_PASSWORD="senha de app de 16 caracteres"

# Protege o endpoint /api/cron/lembretes (chamado 1x/dia pelo cron da
# vercel.json) contra acesso externo. A Vercel envia esse valor sozinha como
# header Authorization quando a env var existe — não precisa configurar nada
# além de criar a variável com um valor aleatório.
# CRON_SECRET="uma-string-aleatoria-longa"
