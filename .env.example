# Modo demo (padrão): deixe DATABASE_URL, BLOB_READ_WRITE_TOKEN e ADMIN_*
# comentados/ausentes. O app cria um SQLite sozinho e um admin padrão
# (admin@fgl.com.br / admin123) sem precisar rodar nenhum comando.
# Para produção de verdade, descomente e preencha:
# DATABASE_URL="postgresql://user:password@host:5432/dbname"
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

SESSION_SECRET="troque-este-segredo-em-producao"
BASE_URL="http://localhost:3000"
PORT=3000
# ADMIN_NAME="Administrador FGL"
# ADMIN_EMAIL="admin@fgl.com.br"
# ADMIN_PASSWORD="troque-esta-senha"
