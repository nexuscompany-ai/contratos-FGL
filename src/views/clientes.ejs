<%- include("partials/head", { title }) %>
<%- include("partials/topbar", { userName }) %>
<div class="container">
  <a class="back-link" href="/">← Voltar</a>
  <h1>Clientes</h1>
  <div class="card">
    <form method="get" action="/clientes">
      <input type="text" name="q" placeholder="Pesquisar cliente..." value="<%= q %>" />
    </form>
  </div>

  <div class="card">
    <% if (clientes.length === 0) { %>
      <div class="empty-state">
        <strong>Nenhum cliente encontrado</strong>
        Clientes aparecem aqui assim que aceitam um contrato.
      </div>
    <% } else { %>
      <div class="table-wrap">
      <table>
        <thead><tr><th>Nome</th><th>CPF</th><th>Contratos</th><th></th></tr></thead>
        <tbody>
          <% clientes.forEach(function(c) { %>
            <tr>
              <td><%= c.nomeCompleto %></td>
              <td><%= c.cpf || "—" %></td>
              <td><%= c.contracts.length %></td>
              <td><a href="/clientes/<%= c.id %>">Ver</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      </div>
    <% } %>
  </div>
</div>
</body>
</html>
