<%- include("partials/head", { title }) %>
<%- include("partials/topbar", { userName }) %>
<div class="container narrow">
  <a class="back-link" href="/">← Voltar</a>
  <h1>Contrato gerado com sucesso</h1>
  <div class="card">
    <p class="muted">Envie este link para o cliente preencher os dados e aceitar o contrato.</p>
    <p><strong>Link para o cliente</strong></p>
    <div class="linkbox" id="link"><%= link %></div>
    <div class="actions">
      <button class="btn secondary" onclick="navigator.clipboard.writeText(document.getElementById('link').innerText); this.innerText='Copiado!'">Copiar link</button>
      <a class="btn" href="mailto:?subject=Contrato FGL Contratos&body=Acesse o link para preencher e aceitar o contrato: <%= encodeURIComponent(link) %>">Enviar</a>
    </div>
  </div>
</div>
</body>
</html>
