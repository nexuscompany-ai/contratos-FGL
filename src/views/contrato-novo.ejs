<%- include("partials/head", { title }) %>
<%- include("partials/topbar", { userName }) %>
<div class="container narrow">
  <h1>Enviar contrato</h1>
  <div class="card">
    <% if (typeof error !== "undefined" && error) { %>
      <div class="flash"><%= error %></div>
    <% } %>
    <form method="post" action="/contratos/novo" id="form-novo-contrato">
      <label>Plano</label>
      <select name="tipoContrato" id="tipoContrato" required>
        <option value="">Selecione o plano</option>
        <option value="Proteção Veicular">Proteção Veicular</option>
        <option value="Plano Básico">Plano Básico (Rastreamento)</option>
      </select>

      <div id="campo-fipe">
        <label>Valor da Tabela FIPE</label>
        <input type="text" name="valorFipe" id="valorFipe" placeholder="R$ 00.000,00" />
      </div>

      <div class="actions">
        <button class="btn block" type="submit">GERAR CONTRATO</button>
      </div>
    </form>
  </div>
</div>
<script>
  (function () {
    var select = document.getElementById("tipoContrato");
    var campoFipe = document.getElementById("campo-fipe");
    var inputFipe = document.getElementById("valorFipe");

    function atualizarCampoFipe() {
      var ehProtecao = select.value === "Proteção Veicular";
      campoFipe.style.display = ehProtecao ? "" : "none";
      inputFipe.required = ehProtecao;
      if (!ehProtecao) {
        inputFipe.value = "";
      }
    }

    select.addEventListener("change", atualizarCampoFipe);
    atualizarCampoFipe();
  })();
</script>
</body>
</html>
