<div class="topbar">
  <a class="brand" href="/">
    <img src="/logo.jpg" alt="FGL Contratos" />
    <span>FGL Contratos</span>
  </a>
  <% if (typeof userName !== "undefined" && userName) { %>
    <nav>
      <div class="notif-bell-wrap">
        <button class="notif-bell" id="notifBellBtn" type="button" aria-label="Notificações">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
          <span class="notif-badge" id="notifBadge" hidden>0</span>
        </button>
        <div class="notif-panel" id="notifPanel" hidden>
          <div class="notif-panel-head">
            <strong>Notificações</strong>
            <button class="link" id="notifMarkAll" type="button">Marcar todas como lidas</button>
          </div>
          <div class="notif-panel-list" id="notifList">
            <div class="empty-state" style="padding:24px 12px;">Nenhuma notificação ainda.</div>
          </div>
        </div>
      </div>
      <a class="muted" href="/configuracoes" style="font-size:13px;">Configurações</a>
      <span class="muted"><%= userName %></span>
      <form method="post" action="/logout">
        <button class="link" type="submit">Sair</button>
      </form>
    </nav>
  <% } %>
</div>
<% if (typeof userName !== "undefined" && userName) { %>
  <script src="/js/push.js"></script>
  <script src="/js/notif-center.js"></script>
<% } %>
