<div class="topbar">
  <a class="brand" href="/">
    <img src="/logo.jpg" alt="FGL Contratos" />
    <span>FGL Contratos</span>
  </a>
  <% if (typeof userName !== "undefined" && userName) { %>
    <nav>
      <span class="muted"><%= userName %></span>
      <form method="post" action="/logout">
        <button class="link" type="submit">Sair</button>
      </form>
    </nav>
  <% } %>
</div>
