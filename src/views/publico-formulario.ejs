<%- include("partials/head", { title, viewport: "width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" }) %>
<%- include("partials/public-topbar") %>
<div class="container narrow">
  <h1>Contrato de Rastreamento</h1>
  <p class="subtitle">Preencha seus dados para finalizar a contratação. Tipo: <%= contract.tipoContrato %> · Valor FIPE: <%= contract.valorFipe.toLocaleString("pt-BR", { style: "currency", currency: "BRL" }) %></p>

  <div class="card">
    <% if (error) { %>
      <div class="flash"><%= error %></div>
    <% } %>
    <form method="post" action="/contrato/<%= contract.token %>">
      <h2>Dados pessoais</h2>

      <label>Nome completo *</label>
      <input type="text" name="nomeCompleto" required value="<%= old ? old.nomeCompleto : '' %>" />

      <label>CPF</label>
      <input type="text" name="cpf" id="cpf" inputmode="numeric" placeholder="000.000.000-00" value="<%= old ? old.cpf : '' %>" />

      <label>Data de nascimento</label>
      <input type="text" name="dataNascimento" id="dataNascimento" inputmode="numeric" placeholder="DD/MM/AAAA" value="<%= old ? old.dataNascimento : '' %>" />

      <label>Telefone *</label>
      <input type="text" name="telefone" required value="<%= old ? old.telefone : '' %>" />

      <label>E-mail *</label>
      <input type="email" name="email" required value="<%= old ? old.email : '' %>" />

      <h2 style="margin-top:28px;">Dados do veículo</h2>

      <label>Placa *</label>
      <input type="text" name="placa" required style="text-transform:uppercase;" value="<%= old ? old.placa : '' %>" />

      <label>Marca</label>
      <input type="text" name="marca" value="<%= old ? old.marca : '' %>" />

      <label>Modelo *</label>
      <input type="text" name="modelo" required value="<%= old ? old.modelo : '' %>" />

      <label>Ano *</label>
      <input type="text" name="ano" required value="<%= old ? old.ano : '' %>" />

      <h2 style="margin-top:28px;">Leia seu contrato</h2>
      <div class="card" style="max-height:320px; overflow-y:auto; background:var(--bg);">
        <p><%= preambulo %></p>
        <% clausulas.forEach(function(cl) { %>
          <p><strong><%= cl.titulo %></strong></p>
          <% cl.paragrafos.forEach(function(p) { %>
            <p class="muted" style="margin:6px 0;"><%= p %></p>
          <% }) %>
        <% }) %>
      </div>

      <div class="checkbox-row">
        <input type="checkbox" name="aceite" id="aceite" />
        <label for="aceite" style="margin:0;">Li e concordo com os termos e condições do contrato (<%= textoAceite %>)</label>
      </div>

      <div class="actions">
        <button class="btn block" type="submit">Aceitar contrato</button>
      </div>
    </form>
  </div>
</div>
<script>
  (function () {
    var inputCpf = document.getElementById("cpf");
    inputCpf.addEventListener("input", function () {
      var digits = this.value.replace(/\D/g, "").slice(0, 11);
      var out = digits.slice(0, 3);
      if (digits.length > 3) out += "." + digits.slice(3, 6);
      if (digits.length > 6) out += "." + digits.slice(6, 9);
      if (digits.length > 9) out += "-" + digits.slice(9, 11);
      this.value = out;
    });

    var inputNascimento = document.getElementById("dataNascimento");
    inputNascimento.addEventListener("input", function () {
      var digits = this.value.replace(/\D/g, "").slice(0, 8);
      var out = digits.slice(0, 2);
      if (digits.length > 2) out += "/" + digits.slice(2, 4);
      if (digits.length > 4) out += "/" + digits.slice(4, 8);
      this.value = out;
    });
  })();
</script>
<%- include("partials/public-footer") %>
</body>
</html>
