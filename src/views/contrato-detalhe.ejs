<%- include("partials/head", { title }) %>
<%- include("partials/topbar", { userName }) %>
<div class="container">
  <a class="back-link" href="javascript:history.back()">← Voltar</a>
  <h1><%= contract.client ? contract.client.nomeCompleto : "Contrato #" + contract.id.slice(0,8).toUpperCase() %></h1>

  <% if (emailStatus === "enviado") { %>
    <div class="flash success">Contrato finalizado com sucesso. Envio realizado para <%= contract.client ? contract.client.email : "o cliente" %>.</div>
  <% } else if (emailStatus === "erro") { %>
    <div class="flash">O contrato foi processado, mas o envio do e-mail falhou. Veja o histórico de e-mails abaixo ou use "Reenviar contrato".</div>
  <% } else if (emailStatus === "sememail") { %>
    <div class="flash">Contrato processado, mas o cliente não tem e-mail cadastrado — nenhum e-mail foi enviado.</div>
  <% } %>

  <div class="card">
    <span class="badge <%= contract.status %>"><%= contract.status %></span>
    <% if (prestesAVencer) { %> <span class="badge PRESTES">PRESTES A VENCER</span> <% } %>

    <table style="margin-top:16px;">
      <tr><th>Tipo de contrato</th><td><%= contract.tipoContrato %></td></tr>
      <tr><th>Valor FIPE</th><td><%= contract.valorFipe.toLocaleString("pt-BR", { style: "currency", currency: "BRL" }) %></td></tr>
      <% if (contract.vehicle) { %>
        <tr><th>Veículo</th><td><%= contract.vehicle.placa %> — <%= contract.vehicle.marca || "" %> <%= contract.vehicle.modelo || "" %> <%= contract.vehicle.ano || "" %></td></tr>
      <% } %>
      <% if (contract.client) { %>
        <tr><th>CPF</th><td><%= formatCpf(contract.client.cpf) || "—" %></td></tr>
        <tr><th>Telefone</th><td><%= contract.client.telefone || "—" %></td></tr>
        <tr><th>E-mail</th><td><%= contract.client.email || "—" %></td></tr>
      <% } %>
      <% if (contract.acceptance) { %>
        <tr><th>Aceito em</th><td><%= new Date(contract.acceptance.acceptedAt).toLocaleString("pt-BR") %> (IP: <%= contract.acceptance.ip || "—" %>)</td></tr>
      <% } %>
      <% if (contract.startDate) { %>
        <tr><th>Início</th><td><%= new Date(contract.startDate).toLocaleDateString("pt-BR") %></td></tr>
        <tr><th>Vencimento</th><td><%= new Date(contract.endDate).toLocaleDateString("pt-BR") %></td></tr>
      <% } %>
      <% if (contract.approvedBy) { %>
        <tr><th>Aprovado por</th><td><%= contract.approvedBy.name %> em <%= new Date(contract.approvedAt).toLocaleString("pt-BR") %></td></tr>
      <% } %>
      <% if (contract.cancelledAt) { %>
        <tr><th>Cancelado em</th><td><%= new Date(contract.cancelledAt).toLocaleString("pt-BR") %></td></tr>
      <% } %>
    </table>

    <div class="actions">
      <% if (contract.pdfPath) { %>
        <a class="btn secondary" href="/contratos/<%= contract.id %>/pdf" target="_blank">Visualizar / baixar PDF</a>
      <% } %>
      <% if (contract.status === "PENDENTE") { %>
        <form method="post" action="/contratos/<%= contract.id %>/aprovar" onsubmit="return confirm('Aprovar contrato?\n\nO contrato será finalizado e passará para a categoria de contratos ativos.');">
          <button class="btn success" type="submit">Aprovar contrato</button>
        </form>
      <% } %>
      <% if (contract.pdfPath && contract.client && contract.client.email) { %>
        <form method="post" action="/contratos/<%= contract.id %>/reenviar" onsubmit="return confirm('Reenviar o contrato por e-mail para ' + '<%= contract.client.email %>' + '?');">
          <button class="btn secondary" type="submit">Reenviar contrato</button>
        </form>
      <% } %>
      <% if (["GERADO", "PENDENTE", "ATIVO"].includes(contract.status)) { %>
        <form method="post" action="/contratos/<%= contract.id %>/cancelar" onsubmit="return confirm('Cancelar este contrato?\n\nEssa ação não pode ser desfeita.');">
          <button class="btn danger" type="submit">Cancelar contrato</button>
        </form>
      <% } %>
    </div>
  </div>

  <% if (contract.emailLogs && contract.emailLogs.length > 0) { %>
    <div class="card">
      <h2>Histórico de e-mails</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Tipo</th><th>Destinatário</th><th>Data</th><th>Status</th></tr></thead>
          <tbody>
            <% contract.emailLogs.forEach(function(log) { %>
              <tr>
                <td><%= ({BOAS_VINDAS: "Contrato finalizado", REENVIO: "Reenvio", LEMBRETE_30: "Lembrete 30 dias", VENCIMENTO: "Lembrete de vencimento", CANCELAMENTO: "Cancelamento"})[log.tipo] || log.tipo %></td>
                <td><%= log.destinatario %></td>
                <td><%= new Date(log.createdAt).toLocaleString("pt-BR") %></td>
                <td>
                  <% if (log.status === "ENVIADO") { %>
                    <span class="badge ATIVO">ENVIADO</span>
                  <% } else if (log.status === "ERRO") { %>
                    <span class="badge VENCIDO" title="<%= log.erro || '' %>">ERRO</span>
                  <% } else { %>
                    <span class="badge">PULADO</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
</div>
</body>
</html>
