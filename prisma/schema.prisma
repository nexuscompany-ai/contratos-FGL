generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FUNCIONARIO
}

enum ContractStatus {
  GERADO    // criado pela FGL, aguardando cliente preencher/aceitar
  PENDENTE  // cliente preencheu e aceitou, aguardando aprovação da FGL
  ATIVO     // aprovado pela FGL, dentro da vigência
  VENCIDO   // vigência encerrada
  CANCELADO // cancelado manualmente pela FGL
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(FUNCIONARIO)
  createdAt DateTime @default(now())

  contratosCriados   Contract[] @relation("CriadoPor")
  contratosAprovados Contract[] @relation("AprovadoPor")
  pushSubscriptions  PushSubscription[]
  notifications      Notification[]
}

model Client {
  id            String   @id @default(cuid())
  nomeCompleto  String
  cpf           String
  dataNascimento String?
  endereco      String?
  telefone      String?
  email         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contracts Contract[]

  @@index([cpf])
}

model Vehicle {
  id        String   @id @default(cuid())
  placa     String
  renavam   String?
  chassi    String?
  modelo    String?
  marca     String?
  ano       String?
  valorFipe Float?
  createdAt DateTime @default(now())

  contracts Contract[]

  @@index([placa])
}

model Contract {
  id           String         @id @default(cuid())
  token        String         @unique
  tipoContrato String
  valorFipe    Float
  status       ContractStatus @default(GERADO)

  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id])
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  pdfPath   String?

  startDate DateTime?
  endDate   DateTime?

  createdAt   DateTime  @default(now())
  filledAt    DateTime?
  approvedAt  DateTime?
  cancelledAt DateTime?

  boasVindasEmailSentAt   DateTime? // e-mail de aprovação/boas-vindas
  lembrete30EmailSentAt   DateTime? // lembrete amigável 30 dias antes do vencimento
  vencimentoEmailSentAt   DateTime? // lembrete amigável no dia do vencimento

  createdById  String?
  createdBy    User?   @relation("CriadoPor", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?   @relation("AprovadoPor", fields: [approvedById], references: [id])

  acceptance Acceptance?
  emailLogs  EmailLog[]
  notifications Notification[]

  pushNotifiedAt DateTime? // marca o disparo do push de "novo contrato pendente" — garante 1x por contrato

  @@index([status])
}

model Acceptance {
  id         String   @id @default(cuid())
  contractId String   @unique
  contract   Contract @relation(fields: [contractId], references: [id])
  acceptedAt DateTime @default(now())
  ip         String?
  userAgent  String?
  version    String   @default("1")
}

/// Registro de cada tentativa de envio de e-mail transacional (aprovação,
/// lembretes, cancelamento, reenvio) — pra auditoria e pra evitar disparo
/// duplicado silencioso.
model EmailLog {
  id           String    @id @default(cuid())
  contractId   String?
  contract     Contract? @relation(fields: [contractId], references: [id])
  tipo         String    // BOAS_VINDAS | REENVIO | LEMBRETE_30 | VENCIMENTO | CANCELAMENTO
  destinatario String
  clienteNome  String?
  status       String    // ENVIADO | ERRO | PULADO
  erro         String?
  messageId    String?
  createdAt    DateTime  @default(now())

  @@index([contractId])
}

/// Um dispositivo (navegador/PWA) inscrito para receber Web Push. Um mesmo
/// usuário pode ter várias (iPhone, computador etc.) — nunca sobrescreve,
/// só desativa quando o endpoint para de responder (410/404).
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  label      String?   // ex.: "iPhone", "Chrome no computador" — derivado do user-agent
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())

  logs PushLog[]

  @@index([userId])
}

/// Item da central de notificações do CRM (sino no topo). Hoje só o evento
/// "novo contrato pendente"; type deixa aberto pra outros eventos futuros
/// sem precisar de migration nova.
model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  type       String    // NOVO_CONTRATO_PENDENTE
  title      String
  body       String
  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id])
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([contractId])
}

/// Log de cada tentativa de envio de Web Push — pra diagnosticar "por que
/// o Felipe não recebeu a notificação" sem expor nada sensível.
model PushLog {
  id             String            @id @default(cuid())
  subscriptionId String?
  subscription   PushSubscription? @relation(fields: [subscriptionId], references: [id])
  userId         String?
  contractId     String?
  event          String            // NOVO_CONTRATO_PENDENTE | TESTE
  status         String            // ENVIADO | ERRO | REMOVIDO_INVALIDO
  erro           String?
  createdAt      DateTime          @default(now())

  @@index([subscriptionId])
}
