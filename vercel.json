{
  "framework": null,
  "buildCommand": "prisma generate && prisma migrate deploy && (npm run seed || true)",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{src/views/**,src/public/**,prisma/migrations/**}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
